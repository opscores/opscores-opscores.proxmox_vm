---
# Inventory file for opscores.proxmox_vm
#
# Sensitive variables (vault_*) are stored in group_vars/all/vault.yml
# and encrypted with ansible-vault:
#   ansible-vault encrypt group_vars/all/vault.yml
#
# All playbooks must be run with --ask-vault-pass

all:
  children:
    proxmox:
      hosts:
        pve01:
          # SSH connection — user comes from vault, become via sudo + SSH key
          ansible_host: 192.168.160.200
          ansible_user: "{{ vault_ansible_user | default('ansible') }}"
          ansible_become: true
          ansible_become_method: sudo
          ansible_become_user: root

          # Proxmox API credentials (for qm shell commands)
          proxmox_host: "192.168.160.200"
          proxmox_node: "pve01"
          proxmox_user: "root@pam"
          proxmox_password: "{{ vault_proxmox_password }}"

      vars:
        # Convenience: define SSH key once per inventory group
        ssh_public_key: "{{ lookup('file', '~/.ssh/id_rsa.pub') }}"
