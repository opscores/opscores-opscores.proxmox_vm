#cloud-config
# AlmaLinux-specific cloud-init configuration

hostname: "{{ new_vm_name }}"
manage_etc_hosts: false
preserve_hostname: false

# Локализация
timezone: "{{ timezone | default('Europe/Moscow') }}"
locale: en_US.UTF-8

# Диск - автоматическое расширение root раздела
resize_rootfs: true
growpart:
  mode: auto
  devices: ['/']

# Обновления и пакеты (RHEL-specific)
package_update: false
package_upgrade: false
packages:
  - qemu-guest-agent
  - mc
  - curl
  - wget
  - htop
  - net-tools
  - bind-utils
  - cloud-utils-growpart
  - epel-release
  - dnf-utils
  - firewalld

# Пользователи (RHEL-specific groups)
users:
  - name: {{ cloud_user }}
    primary_group: {{ cloud_user }}
    groups: [wheel, adm, systemd-journal]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: false
    passwd: "{{ cloud_password | password_hash('sha512') }}"
    ssh_authorized_keys:
      - {{ ssh_public_key }}

# Безопасность
ssh_pwauth: true
# disable_root: true blocks root SSH login declaratively at the cloud-init level
# (independent of the base image's sshd_config defaults). Kept consistent with the
# Ubuntu templates; does not affect cloud_user or its password/ssh_pwauth settings.
disable_root: true

# Команды при загрузке
bootcmd:
  - [systemd-machine-id-setup]

# Выполняемые команды (RHEL-specific)
runcmd:
  # Установка hostname
  - [hostnamectl, set-hostname, "{{ new_vm_name }}"]
  # Настройка времени
  - [timedatectl, set-timezone, "{{ timezone | default('Europe/Moscow') }}"]
  # QEMU Guest Agent
  - [systemctl, enable, qemu-guest-agent]
  - [systemctl, start, qemu-guest-agent]
  # Firewall (RHEL-specific)
  - [systemctl, enable, firewalld]
  - [systemctl, start, firewalld]
  - [firewall-cmd, --add-service=ssh, --permanent]
  - [firewall-cmd, --add-service=http, --permanent]
  - [firewall-cmd, --add-service=https, --permanent]
  - [firewall-cmd, --reload]
  # Настройка SSH
  - [sed, -i, 's/^#?PubkeyAuthentication.*/PubkeyAuthentication yes/', /etc/ssh/sshd_config]
  - [sed, -i, 's/#PasswordAuthentication yes/PasswordAuthentication yes/', /etc/ssh/sshd_config]
  - [sed, -i, 's/#PermitRootLogin yes/PermitRootLogin no/', /etc/ssh/sshd_config]
  - [sed, -i, 's/PasswordAuthentication no/PasswordAuthentication yes/', /etc/ssh/sshd_config]
  - [systemctl, restart, sshd]
  # Установка прав на SSH-ключи
  - [chown, -R, '{{ cloud_user }}:{{ cloud_user }}', '/home/{{ cloud_user }}/.ssh']
  - ['chmod', '700', '/home/{{ cloud_user }}/.ssh']
  - ['chmod', '600', '/home/{{ cloud_user }}/.ssh/authorized_keys']
  # DNF настроики (RHEL-specific)
  - [dnf, config-manager, --set-enabled, crb]
# Финальные сообщения

final_message: "AlmaLinux cloud-init completed successfully at $UPTIME"